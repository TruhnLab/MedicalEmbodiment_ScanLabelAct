# Copy to .env (gitignored) and fill in. Read by landerpi/settings.py; an environment variable of the same name wins.

# OpenAI-compatible model gateway (vLLM): scene labelling, the task console's chat, image checks
VLLM_URL=https://<gateway-host>:<port>/v1/chat/completions
VLLM_MODEL=nvidia/Qwen3.8-Flash-Next-NVFP4
VLLM_API_KEY=<key for the labelling>
VLLM_CHAT_API_KEY=<key for the chat>
# models that must never be used: comma-separated parts of model names (optional)
VLLM_BLOCKED_MODELS=

# the robot's SSH login (tools/robot_helper.py, the recorder, the navigator)
LANDERPI_USER=pi
LANDERPI_PASSWORD=<the robot's password>

# Slurm GPU cluster (optional: scene labelling falls back to the laptop's CPU; tools/gpu_cluster.py)
CLUSTER_MASTER=<user>@<slurm-master>
CLUSTER_STORAGE=<user>@<storage-server>
CLUSTER_SCENES_ON_MASTER=<scenes folder as the cluster sees it>
CLUSTER_SCENES_ON_STORAGE=<the same folder as the storage server sees it>
CLUSTER_MODELS_ON_MASTER=<YOLOE weights folder on the cluster>
CLUSTER_PARTITION=<Slurm partition, empty for the default>
